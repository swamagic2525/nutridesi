{
  "name": "nutridesi",
  "version": "0.1.0",
  "description": "WhatsApp-native Indian food calorie tracking bot",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "local": "caffeinate -dims node server.js",
    "dev": "node --watch server.js",
    "smoke": "node test/smoke-test.js",
    "test:corrections": "node test/correction-context-test.js",
    "test:metrics": "node test/metrics-test.js",
    "test:guard": "node test/protein-guard-test.js",
    "test:context": "node test/context-guard-test.js",
    "test:serving": "node test/serving-size-test.js",
    "test:ref": "node test/ref-guard-test.js",
    "test:rerank": "node test/rerank-test.js",
    "test:brand": "node test/brand-rerank-test.js",
    "test:tdee": "node test/tdee-test.js",
    "test:routing": "node test/server-routing-test.js",
    "test:reminders": "node test/reminders-test.js",
    "test:outcomes": "node test/outcomes-test.js",
    "test:claim": "node test/summary-claim-test.js",
    "test:undoall": "node test/undo-all-test.js",
    "test:memory": "node test/conversation-memory-test.js",
    "outcomes": "node scripts/outcome-report.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.19.2",
    "twilio": "^5.3.0",
    "dotenv": "^16.4.5"
  }
}
